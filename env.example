# Copy to `env`, fill in, install to /root/finn/env with mode 0600.
FINN_TELEGRAM_TOKEN=123456:AA...
FINN_ANTHROPIC_KEY=sk-ant-...
FINN_OWNER_ID=            # your numeric telegram user id; nobody else is answered
FINN_DESK_HOST=iMac       # DHCP hostnames of the devices it should recognise
FINN_PHONE_HOST=iPhone
FINN_LAPTOP_HOST=Mac
